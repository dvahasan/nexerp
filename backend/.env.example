# ── Required ──────────────────────────────────────────────────────────────────
# MongoDB connection string (MONGO_URL is accepted as an alias)
MONGODB_URI=mongodb://localhost:27017/nexerp
# Strong random secret for signing JWTs. The server REFUSES TO START without it.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Security / environment ────────────────────────────────────────────────────
# Developer console master key (≥16 chars). /api/dev stays DISABLED unless set.
DEV_MASTER_KEY=
# Seed the NEX-01 demo company + demo users on boot. NEVER set in production.
SEED_DEMO=false
# Comma-separated list of allowed browser origins for CORS (production frontend URLs).
# localhost dev ports are always allowed.
CLIENT_URL=

# ── Billing (Stripe) ──────────────────────────────────────────────────────────
# Leave unset to disable billing entirely (plan limits are then not enforced).
# Use test-mode keys (sk_test_...) until launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs (recurring monthly) for each tier
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# ── Optional integrations ─────────────────────────────────────────────────────
# Google Gemini key — enables the real AI chat + AI CSV column mapping
# (without it both silently fall back to keyword/heuristic mode)
GEMINI_API_KEY=
# Cloudinary (item photos, logos, stamps)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# SMTP for welcome emails (mailer.js)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
